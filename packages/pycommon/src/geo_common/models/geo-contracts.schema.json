{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geo-prospecting-platform.invalid/schemas/geo-contracts.schema.json",
  "title": "GeoContracts",
  "description": "Shared contracts (ADR-0009, ADR-0010, ADR-0011). Single source of truth; Pydantic and TypeScript types are generated from this file.",
  "type": "object",
  "properties": {
    "job": { "$ref": "#/definitions/Job" },
    "result_envelope": { "$ref": "#/definitions/ResultEnvelope" }
  },
  "definitions": {
    "JobStatus": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "cancelled", "insufficient_data"]
    },
    "JobType": {
      "description": "Phase 1 allows only the noop job. Later phases extend this enum.",
      "type": "string",
      "enum": ["noop"]
    },
    "Job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "priority", "attempts", "max_attempts", "cancel_requested", "created_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "$ref": "#/definitions/JobType" },
        "status": { "$ref": "#/definitions/JobStatus" },
        "priority": { "type": "integer" },
        "attempts": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "cancel_requested": { "type": "boolean" },
        "error": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "moderate", "high"] },
        "basis": { "type": "string", "minLength": 1, "description": "Why this level: data quality, concordant evidence lines, validation status, coverage." }
      }
    },
    "QuantifiedUncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "value"],
      "properties": {
        "status": { "type": "string", "enum": ["quantified"] },
        "method": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "NotQuantifiedUncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "type": "string", "enum": ["not_quantified"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "Uncertainty": {
      "anyOf": [
        { "$ref": "#/definitions/QuantifiedUncertainty" },
        { "$ref": "#/definitions/NotQuantifiedUncertainty" }
      ]
    },
    "Explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "supporting", "counter_evidence", "limitations"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "supporting": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "counter_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "version", "acquired", "licence"],
      "properties": {
        "dataset": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "acquired": { "type": "string", "minLength": 1, "description": "Acquisition date or interval (ISO 8601)." },
        "licence": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "via": { "type": "string", "enum": ["stac", "earth_engine", "direct", "user_upload"] }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "code_version", "parameters", "created_at"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "code_version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "aoi_hash": { "type": "string" },
        "crs": { "type": "string" },
        "dependency_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "Depth": {
      "description": "Present only with a geophysics/verification basis (docs/scientific-constraints.md rule 4). Surface-only data MUST NOT produce depth.",
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "method", "value_m", "uncertainty_m"],
      "properties": {
        "basis": { "type": "string", "enum": ["field_geophysics", "direct_verification"] },
        "method": { "type": "string", "minLength": 1 },
        "value_m": { "type": "number" },
        "uncertainty_m": { "type": "number", "minimum": 0 }
      }
    },
    "ResultEnvelope": {
      "description": "Mandatory envelope for every layer/target. No `confirmed_*` kinds exist; validation_status is unvalidated only in V1 (ADR-0010).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "value", "confidence", "uncertainty", "explanation", "sources", "provenance",
        "disclaimer_id", "validation_status", "calibration_status", "engine_status"
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["prospectivity", "anomaly", "evidence", "geophysics_model"] },
        "value": { "type": ["number", "string", "null"] },
        "confidence": { "$ref": "#/definitions/Confidence" },
        "uncertainty": { "$ref": "#/definitions/Uncertainty" },
        "explanation": { "$ref": "#/definitions/Explanation" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Source" } },
        "provenance": { "$ref": "#/definitions/Provenance" },
        "disclaimer_id": { "type": "string", "enum": ["D-1", "D-2"] },
        "validation_status": { "type": "string", "enum": ["unvalidated"] },
        "calibration_status": { "type": "string", "enum": ["uncalibrated", "calibrated"] },
        "engine_status": { "type": "string", "enum": ["experimental", "validated"] },
        "deposit_model": { "type": "string", "enum": ["orogenic"] },
        "applicability": { "type": "string", "enum": ["applicable", "applicability_unknown"] },
        "depth": { "$ref": "#/definitions/Depth" }
      },
      "dependencies": {
        "deposit_model": ["applicability"],
        "depth": { "properties": { "disclaimer_id": { "enum": ["D-2"] } } }
      }
    }
  }
}
