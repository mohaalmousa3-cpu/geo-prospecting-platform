# Copy to .env (git-ignored). Placeholders only — NEVER commit real values.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL/PostGIS) ---
POSTGRES_USER=geo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geo_prospecting
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Queue ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (local volume by default; S3-compatible optional) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/processed
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# --- Compute budgets (enforced at job creation) ---
MAX_AOI_AREA_KM2=100
MAX_TIME_WINDOW_DAYS=365
MAX_SCENES_PER_JOB=50
JOB_TIMEOUT_SECONDS=3600
MAX_UPLOAD_MB=25

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Optional: only if you explicitly choose Cesium ion (paid/limited tier). Leave empty for open terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Optional connectors (all disabled by default; require explicit approval) ---
ENABLE_EARTH_ENGINE=false
# EARTH_ENGINE_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=      # path to service-account file kept OUTSIDE the repo
ENABLE_INSAR_WORKER=false
ENABLE_GEMPY_WORKER=false
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# CDS_API_KEY=
