# Copy to .env (git-ignored). Placeholders only — NEVER commit real values.
# V1: local/private use only, no authentication (ADR-0005). Do not expose publicly.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
# Bind published ports to loopback only (ADR-0005)
BIND_HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL/PostGIS) ---
POSTGRES_USER=geo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geo_prospecting
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Storage: local filesystem only in V1 (ADR-0006) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/processed

# --- Job queue: PostgreSQL-backed (ADR-0007) ---
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=2
MAX_QUEUED_JOBS=10

# --- Conservative MVP limits (ADR-0008; unmeasured starting values) ---
MAX_AOI_AREA_KM2=25
MAX_RADIUS_KM=2.5
MIN_AOI_AREA_KM2=0.01
MAX_AOI_VERTICES=2000
MAX_UPLOAD_MB=10
MAX_PROJECTS=20
MAX_STORED_AOIS=100
MAX_ARCHIVE_UNCOMPRESSED_MB=50
MAX_ARCHIVE_FILES=50
MAX_TIME_WINDOW_DAYS=365
MAX_SCENES_PER_JOB=20
JOB_TIMEOUT_SECONDS=1800

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Basemap (ADR-0012, ADR-0013). Tile requests reveal the viewed map area to the tile provider.
# NEXT_PUBLIC_BASEMAP_PROVIDER: osm (OpenStreetMap, low-volume development only) | xyz (your own
# https tile URL below, must contain {z}/{x}/{y}) | none (no basemap, no third-party requests).
NEXT_PUBLIC_BASEMAP_PROVIDER=osm
# Used only when the provider is xyz:
NEXT_PUBLIC_BASEMAP_TILE_URL=
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
# Optional: only if you explicitly choose Cesium ion (paid/limited tier). Leave empty for open terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Optional connectors (disabled by default; ADR-0004) ---
# Earth Engine: experimental / NON-COMMERCIAL use only. Keep credentials OUTSIDE the repo.
ENABLE_EARTH_ENGINE=false
# EARTH_ENGINE_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
ENABLE_INSAR_WORKER=false
ENABLE_GEMPY_WORKER=false
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# CDS_API_KEY=

# Optional (compose build only): CA bundle path for TLS-intercepting proxies
# PROXY_CA_BUNDLE=
