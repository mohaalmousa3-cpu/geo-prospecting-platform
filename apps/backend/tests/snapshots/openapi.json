  "info": {
    "description": "\n**V1 has no authentication. Local/private use only \u2014 do not expose to the public internet.**\n\nOutputs of this platform are prospectivity/anomaly layers, never confirmation of gold, caves or voids.\nPhase 2.5 exposes health checks, a `noop` job, projects and AOI input/validation/persistence.\nNo analysis, scoring, remote-sensing, Earth Engine or scientific result exists yet.\n",
    "title": "geo-prospecting-platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/aois": {
      "get": {
        "operationId": "list_aois_api_v1_aois_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AoiList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List saved AOIs (newest first)",
        "tags": [
          "aois"
        ]
      },
      "post": {
        "operationId": "create_api_v1_aois_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "point_radius": "#/components/schemas/AoiPointRadiusRequest",
                    "polygon": "#/components/schemas/AoiPolygonRequest",
                    "rectangle": "#/components/schemas/AoiRectangleRequest"
                  },
                  "propertyName": "method"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AoiPointRadiusRequest"
                  },
                  {
                    "$ref": "#/components/schemas/AoiRectangleRequest"
                  },
                  {
                    "$ref": "#/components/schemas/AoiPolygonRequest"
                  }
                ],
                "title": "Body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aoi"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create an AOI",
        "tags": [
          "aois"
        ]
      }
    },
    "/api/v1/aois/limits": {
      "get": {
        "operationId": "limits_api_v1_aois_limits_get",
