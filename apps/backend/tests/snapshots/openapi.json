            "$ref": "#/components/schemas/JobStatus"
          },
          "type": {
            "$ref": "#/components/schemas/JobType"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "priority",
          "attempts",
          "max_attempts",
          "cancel_requested",
          "created_at"
