          }
        },
        "summary": "Provisional AOI limits (ADR-0008)",
        "tags": [
          "aois"
        ]
      }
    },
    "/api/v1/aois/preview": {
      "post": {
        "operationId": "preview_api_v1_aois_preview_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "point_radius": "#/components/schemas/AoiPointRadiusRequest",
                    "polygon": "#/components/schemas/AoiPolygonRequest",
                    "rectangle": "#/components/schemas/AoiRectangleRequest"
                  },
                  "propertyName": "method"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AoiPointRadiusRequest"
                  },
                  {
                    "$ref": "#/components/schemas/AoiRectangleRequest"
                  },
                  {
                    "$ref": "#/components/schemas/AoiPolygonRequest"
                  }
                ],
                "title": "Body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AoiDraft"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate and normalise an AOI without saving",
        "tags": [
          "aois"
        ]
      }
    },
